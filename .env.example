# Required public identity. PUBLIC_ORIGIN must exactly match the browser URL.
PUBLIC_ORIGIN=https://app.example.com
RP_ID=app.example.com
RP_NAME=My Internal App

# Local listener and protected upstream app.
PORT=8091
UPSTREAM_ORIGIN=http://app:8080
DATA_DIR=/data

# Generate with: node scripts/generate-secrets.mjs
SESSION_SECRET=replace-with-random-secret
BOOTSTRAP_TOKEN=replace-with-one-time-setup-token
SESSION_TTL_SECONDS=43200

# First account labels used during bootstrap passkey creation.
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=App admin

# Upstream auth modes:
# - none: app has no login, Pass Key App only gates access
# - basic: inject HTTP Basic Authorization upstream
# - header: inject one static upstream auth header
# - form: log into the upstream app server-side and reuse its Set-Cookie session
UPSTREAM_AUTH_MODE=none

# BASIC mode
# UPSTREAM_BASIC_USERNAME=admin
# UPSTREAM_BASIC_PASSWORD=change-me

# HEADER mode
# UPSTREAM_AUTH_HEADER_NAME=Authorization
# UPSTREAM_AUTH_HEADER_VALUE=Bearer change-me

# FORM mode
# UPSTREAM_LOGIN_PATH=/api/v2/auth/login
# UPSTREAM_LOGIN_METHOD=POST
# UPSTREAM_LOGIN_CONTENT_TYPE=form
# UPSTREAM_LOGIN_USERNAME_FIELD=username
# UPSTREAM_LOGIN_PASSWORD_FIELD=password
# UPSTREAM_LOGIN_USERNAME=admin
# UPSTREAM_LOGIN_PASSWORD=change-me
# UPSTREAM_LOGIN_SUCCESS_STATUS=200,204
# UPSTREAM_SESSION_COOKIE_REGEX=^QBT_SID
# UPSTREAM_SESSION_TTL_SECONDS=3000

# Reverse proxy behavior.
REWRITE_UPSTREAM_ORIGIN=true
STRIP_UPSTREAM_SET_COOKIE=true
FORWARD_CLIENT_COOKIES=false
